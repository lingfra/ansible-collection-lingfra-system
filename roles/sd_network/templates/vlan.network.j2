# {{ ansible_managed }}
#
# {{ vlan.files.vlan_network | default('N/A') }}

[Match]
Name={{ vlan.device_vlan }}

[Network]
{% if vlan.create_bridge %}
Bridge={{ vlan.device_bridge }}
{% else %}
DHCP={{ 'yes' if vlan.dhcp else 'no' }}
{% if (vlan.address is defined) and (vlan.address is not none) %}
Address={{ vlan.address }}
Gateway={{ vlan.gateway }}
{% endif %}
{% endif %}
{% if (vlan.dns is defined) and (vlan.dns is not none) %}
DNS={{ vlan.dns }}
{% endif %}

# End of file
