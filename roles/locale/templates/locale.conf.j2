LANG={{ locale_conf_lang }}
{% if (locale_conf_extra_options is defined) and (locale_conf_extra_options.keys() | length > 0) %}
# extra options

{% for k, v in locale_conf_extra_options.items() %}
{{ k }}={{ v }}
{% endfor %}
{% endif %}
